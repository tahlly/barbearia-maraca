# ======================================================================
# AMBIENTE DE SERVIDOR (lab) — PRONTO PARA COPIAR E SUBIR
# Branch: developer-com-pagamento-servidor
# ======================================================================
# Como usar (passo a passo para o colega do deploy):
#
#  1. Copie este arquivo como ".env" na RAIZ do deploy no servidor:
#       cp .env.servidor.example .env
#  2. Preencha os valores marcados com ">>> COPIAR DO .env LOCAL <<<":
#     GOOGLE_CLIENT_SECRET, MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_PUBLIC_KEY,
#     MERCADOPAGO_WEBHOOK_SECRET e SMTP_PASS.
#  3. Rode o build do frontend COM ESTE .env na raiz: o Vite lê o .env da
#     raiz (envDir) e injeta VITE_API_BASE_URL=/server02/api no bundle.
#     ATENÇÃO: no lab o SPA com VITE_API_BASE_URL=/api NAO funciona (502).
#  4. Suba migrations e, se quiser massa de demonstração, o seed.
#  5. Nunca commite este arquivo preenchido: o .env do servidor fica fora do Git.
#
# Google (console OAuth) para este ambiente — configurar lá fora:
#   - Origem JavaScript autorizada: https://lab.alphaedtech.org.br
#   - URI de redirecionamento autorizada: https://lab.alphaedtech.org.br
#   (o backend valida o idToken via GOOGLE_CLIENT_ID; GOOGLE_REDIRECT_URI
#   fica registrado abaixo para rastreio.)
#
# Mercado Pago — CONFIRMADO modo teste no painel (sem flag de sandbox):
#   - Reutilizar as MESMAS credenciais APP_USR do .env local; o checkout
#     devolve sandbox_init_point porque a app está em modo teste.
#   - MERCADOPAGO_WEBHOOK_SECRET deve continuar igual ao do painel do MP
#     (usado na validação HMAC do webhook).

# ===== Docker Compose =====
COMPOSE_DB_PORT=5432
COMPOSE_DB_USER=postgres
COMPOSE_DB_PASSWORD=postgres
COMPOSE_DB_NAME=barbearia_maraca
COMPOSE_DB_TEST_NAME=barbearia_maraca_test
BACKEND_PORT=3000
FRONTEND_PORT=5173

# ===== Backend: execução com PostgreSQL do ambiente =====
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=barbearia_maraca
DB_NAME_TEST=barbearia_maraca_test

# ===== Autenticação JWT =====
# Mantido como está (sem mudanças de segurança nesta etapa — pendência registrada).
JWT_SECRET=troque-por-um-segredo-local-forte
JWT_EXPIRES_IN=30m

# ===== Login com Google (OAuth 2.0) =====
VITE_GOOGLE_CLIENT_ID=268265693468-2bop7rv1onm6mcmlbqvdj09l0hnsl8dn.apps.googleusercontent.com
GOOGLE_CLIENT_ID=268265693468-2bop7rv1onm6mcmlbqvdj09l0hnsl8dn.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=>>> COPIAR DO .env LOCAL <<<
GOOGLE_REDIRECT_URI=https://lab.alphaedtech.org.br

# ===== Mercado Pago (Checkout Pro — modo teste) =====
MERCADOPAGO_ACCESS_TOKEN=>>> COPIAR DO .env LOCAL <<<
MERCADOPAGO_PUBLIC_KEY=>>> COPIAR DO .env LOCAL <<<
MERCADOPAGO_WEBHOOK_SECRET=>>> COPIAR DO .env LOCAL <<<

# ===== Recuperação de senha (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=maracabarbearia@gmail.com
SMTP_PASS=>>> COPIAR DO .env LOCAL <<<
SMTP_FROM="Barbearia Maracá <maracabarbearia@gmail.com>"
RESET_TOKEN_TTL_MIN=30

# ===== URLs públicas (SERVIDOR) =====
# base do SPA (emails de redefinição de senha)
FRONTEND_URL=https://lab.alphaedtech.org.br/server02
# base pública HTTPS usada nas back_urls do Checkout Pro (Mercado Pago rejeita localhost)
FRONTEND_URL_PUBLICA=https://lab.alphaedtech.org.br/server02
# base pública usada na notification_url do webhook
# (https://lab.alphaedtech.org.br/server02/api/webhooks/mercadopago)
API_BASE_URL=https://lab.alphaedtech.org.br/server02

# ===== Frontend (build) =====
VITE_DEFAULT_PASSWORD=123456
VITE_API_BASE_URL=/server02/api

# ===== OpenCode (opcional; remover no servidor) =====
OPENAI_API_KEY=