# ===== Docker Compose =====
# ÚNICO arquivo de ambiente: copie este arquivo como ".env" na RAIZ do projeto
# (ao lado do docker-compose.yml). O Compose lê as variáveis daqui para passar
# aos containers. NÃO crie backend/.env nem frontend/.env (ver AGENTS.md).
# Use 5433 se a porta 5432 já estiver ocupada por um PostgreSQL nativo.
COMPOSE_DB_PORT=5432
COMPOSE_DB_USER=postgres
COMPOSE_DB_PASSWORD=postgres
COMPOSE_DB_NAME=barbearia_maraca
COMPOSE_DB_TEST_NAME=barbearia_maraca_test
BACKEND_PORT=3000
FRONTEND_PORT=5173

# ===== Backend: execução manual com PostgreSQL local =====
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=sua_senha_local
DB_NAME=barbearia_maraca
DB_NAME_TEST=barbearia_maraca_test

# ===== Autenticação JWT =====
# Gere um valor local forte e nunca reutilize este exemplo em produção.
# Em NODE_ENV=production JWT_SECRET é obrigatório: sem ele (ou se vazio/igual ao
# fallback de dev), o processo aborta a inicialização antes de servir requisições.
JWT_SECRET=troque-por-um-segredo-local-forte
JWT_EXPIRES_IN=30m

# ===== Login com Google (OAuth 2.0) =====
# Frontend (Vite): exposto ao navegador — pode usar o Client ID publicamente.
VITE_GOOGLE_CLIENT_ID=
# Backend (Node/Express): NUNCA expor o Client Secret no front-end.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ===== Recuperação de senha (SMTP) =====
# Envio de e-mails de recuperação de senha via SMTP (backend).
# SMTP_HOST: servidor SMTP usado no envio (ex.: smtp.gmail.com para Gmail).
# SMTP_PORT: porta do servidor. 587 para STARTTLS (SMTP_SECURE=false) ou 465 para SSL (SMTP_SECURE=true).
# SMTP_SECURE: true somente quando SMTP_PORT=465 (SSL/TLS direto); false usa STARTTLS na porta 587.
# SMTP_USER: conta que faz o envio. Para Gmail use o endereço completo, ex.: app.barbearia@gmail.com.
# SMTP_PASS: senha de APP (Gmail: Conta Google → Segurança → Verificação em 2 etapas → Senhas de app).
#            Não use a senha normal da conta. Nunca exponha no cliente (sem prefixo VITE_).
# SMTP_FROM: remetente exibido. Atenção: no Gmail o endereço é sobrescrito pelo SMTP_USER autenticado.
# RESET_TOKEN_TTL_MIN: validade do link de redefinição, em minutos (default 30).
# FRONTEND_URL: base usada para montar o link de redefinição no e-mail
#               (dev: http://localhost:5173; produção: URL pública do site).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Barbearia Maracá <no-reply@barbeariamaraca.com>"
RESET_TOKEN_TTL_MIN=30
FRONTEND_URL=http://localhost:5173

# ===== Frontend =====
# Senha padrão usada ao criar funcionários (nível de demo).
# O primeiro acesso desse usuário é obrigado a trocar a senha.
VITE_DEFAULT_PASSWORD=123456
VITE_API_BASE_URL=/api

# ===== OpenCode opcional =====
OPENAI_API_KEY=