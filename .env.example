# Rodando com Docker Compose: preencha e salve este arquivo como ".env"
# AQUI NA RAIZ do projeto (do lado do docker-compose.yml) — é daqui que o
# Compose lê as variáveis pra passar aos containers.
#
# Rodando sem Docker (npm run dev): copie os valores relevantes para
# backend/.env e frontend/.env em vez deste arquivo.

# ===== Banco de Dados (Backend) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=barbearia_maraca
DB_NAME_TEST=barbearia_maraca_test

# ===== Frontend (Vite) =====
# VITE_USE_MOCK_API: ausente = mock (padrão); "false" = API real; qualquer outro valor = mock.
VITE_USE_MOCK_API=

# ===== Login com Google (OAuth 2.0) =====
# Frontend (Vite): exposto ao navegador — pode usar o Client ID publicamente.
VITE_GOOGLE_CLIENT_ID=

# Backend (Node/Express): NUNCA expor o Client Secret no front-end.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
