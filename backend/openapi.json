      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Verifica a saude do servidor e do banco",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "database": {
                      "type": "string",
                      "example": "connected"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        }
      }
    },
