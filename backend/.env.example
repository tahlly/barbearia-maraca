# ===== Banco de Dados (Backend) =====
# Este arquivo é o .env ATIVO do backend (o Knex e o server.ts o leem de backend/.env).
# Copie para backend/.env e preencha com suas credenciais locais.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=sua_senha_aqui
DB_NAME=barbearia_maraca
DB_NAME_TEST=barbearia_maraca_test

# ===== Login com Google (OAuth 2.0) =====
# Frontend (Vite): exposto ao navegador — pode usar o Client ID publicamente.
VITE_GOOGLE_CLIENT_ID=

# Backend (Node/Express): NUNCA expor o Client Secret no front-end.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ===== Autenticação JWT =====
# Segredo usado para assinar tokens JWT. Em produção use um valor forte e secreto.
JWT_SECRET=
JWT_EXPIRES_IN=30m
